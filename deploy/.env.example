# Réglages de deploy/ (facultatif) : copiez ce fichier en deploy/.env puis modifiez-le.
# Sans deploy/.env, les valeurs par défaut de docker-compose.yml s'appliquent.

# Ports ouverts sur votre machine
WEB_PORT=5173
API_PORT=8000
MAILPIT_PORT=8025

# Adresses vues par le navigateur. Si vous changez un port ci-dessus, changez-le ici aussi.
# Sur un serveur : mettez son adresse, ex. http://192.168.1.20:5173 et http://192.168.1.20:8000
WEB_URL=http://localhost:5173
API_URL=http://localhost:8000

# Mot de passe PostgreSQL local (changez-le sur un serveur partagé)
DB_PASSWORD=marketplace

# local + true : messages d'erreur détaillés. Sur un serveur : production + false
APP_ENV=local
APP_DEBUG=true

# E-mails
#   smtp + mailpit  → tout reste sur votre machine (défaut, aucune clé nécessaire)
#   smtp + Mailjet  → envoie de vrais e-mails (parité avec la production) :
#                     MAIL_HOST=in-v3.mailjet.com, MAIL_PORT=587,
#                     MAIL_USERNAME=<API Key Mailjet>, MAIL_PASSWORD=<Secret Key Mailjet>,
#                     expéditeur validé dans Mailjet (Senders & Domains).
#                     ⚠️ clés de production : à mettre dans deploy/.env, jamais dans git.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@tijaralink.test

# Stockage des fichiers envoyés
#   local      → volume Docker api-storage (défaut)
#   cloudinary → envoi sur le CDN (renseignez CLOUDINARY_URL, ex. cloudinary://key:secret@cloud)
MEDIA_DRIVER=local
CLOUDINARY_URL=

# Comptes et données de démonstration au premier démarrage (base vide uniquement)
SEED_DEMO_DATA=true

# --- Base TiDB de production (option avancée, désactivée par défaut) ---
# Par défaut la stack utilise SON PostgreSQL local (service `db`) : ne touchez à
# rien pour développer. Pour brancher l'API sur la base de production :
#
#   docker compose -f docker-compose.yml -f docker-compose.tidb.yml up -d --build
#
# Les valeurs se trouvent dans TiDB Cloud (Connect) et/ou Render → Environment
# du service marketplace-api-v2. Le mot de passe est un secret : jamais dans git.
# TIDB_HOST=<cluster>.gateway01.<region>.prod.aws.pg.tidbcloud.com
# TIDB_PORT=5432
# TIDB_DATABASE=postgres
# TIDB_USERNAME=<utilisateur TiDB>
# TIDB_PASSWORD=<mot de passe TiDB>
