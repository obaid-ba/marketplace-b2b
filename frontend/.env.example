# Adresse de l'API Laravel
VITE_API_URL=http://localhost:8000/api

# Temps réel (messagerie, notifications) : mêmes valeurs que REVERB_* dans backend/.env.
# Laissez VITE_REVERB_APP_KEY vide pour s'en passer : les pages se rafraîchissent à intervalle régulier.
VITE_REVERB_APP_KEY=marketplace-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
