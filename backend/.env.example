APP_NAME="TijaraLink"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Tunis

# Origines autorisées à appeler l'API (séparées par des virgules)
FRONTEND_URLS=http://localhost:5173
# Adresse de l'application web utilisée dans les liens des e-mails (vérification, mot de passe)
FRONTEND_URL=http://localhost:5173

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace_b2b
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Jetons API Sanctum : durée de vie en minutes (7 jours)
SANCTUM_TOKEN_EXPIRATION=10080

# Temps réel (messagerie, notifications) : lancez « php artisan reverb:start » dans un autre terminal.
# Sans Reverb, tout fonctionne : l'application se met à jour toutes les 15 à 30 secondes.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=marketplace-b2b
REVERB_APP_KEY=marketplace-local-key
REVERB_APP_SECRET=marketplace-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@tijaralink.test"
MAIL_FROM_NAME="${APP_NAME}"

# Service IA (F25) : "simulated" (règles de calcul, sans clé) ou "disabled".
# AI_API_KEY et AI_MODEL serviront au fournisseur réel ; ne mettez jamais la clé dans ce fichier.
AI_PROVIDER=simulated
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30
AI_RATE_LIMIT=20

# WhatsApp (SCRUM-133) : "simulated" (rien n'est envoyé) ou "disabled".
# WHATSAPP_SIMULATE_FAILURE=true fait échouer les envois simulés, pour montrer le repli sur l'e-mail.
WHATSAPP_PROVIDER=simulated
WHATSAPP_SIMULATE_FAILURE=false
WHATSAPP_TOKEN=
WHATSAPP_SENDER=
WHATSAPP_TIMEOUT=5

# Ajoutés plus tard : STRIPE_KEY / STRIPE_SECRET (S4)
