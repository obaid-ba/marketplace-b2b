APP_NAME="Marketplace B2B"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Tunis

# Origines autorisées à appeler l'API (séparées par des virgules)
FRONTEND_URLS=http://localhost:5173

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=marketplace_b2b
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Jetons API Sanctum : durée de vie en minutes (7 jours)
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@marketplace.test"
MAIL_FROM_NAME="${APP_NAME}"

# Ajoutés plus tard : STRIPE_KEY / STRIPE_SECRET (S4), REVERB_* (S5), clé du fournisseur IA (S6)
