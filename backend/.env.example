APP_NAME="Marketplace B2B"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR
APP_TIMEZONE=Africa/Tunis

# Origines autorisées à appeler l'API (séparées par des virgules)
FRONTEND_URLS=http://localhost:5173
# Adresse de l'application web utilisée dans les liens des e-mails (vérification, mot de passe)
FRONTEND_URL=http://localhost:5173

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL (local : voir deploy/docker-compose.yml, service "db").
# En production, Neon fournit une URL complète : DB_URL=postgresql://...?sslmode=require
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=marketplace_b2b
DB_USERNAME=marketplace
DB_PASSWORD=marketplace
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Jetons API Sanctum : durée de vie en minutes (7 jours)
SANCTUM_TOKEN_EXPIRATION=10080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# E-mails
#   local  : MAIL_MAILER=log (écrits dans storage/logs) ou smtp vers Mailpit (127.0.0.1:1025)
#   Brevo  : MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
#            MAIL_USERNAME=<login SMTP Brevo>, MAIL_PASSWORD=<clé SMTP Brevo>,
#            expéditeur/domaine validé dans Brevo
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@marketplace.test"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage des fichiers envoyés
#   local      : disques Laravel (storage/app), aucun réglage supplémentaire
#   cloudinary : photos et logos publics, documents en URLs signées
MEDIA_DRIVER=local
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Ajoutés plus tard : STRIPE_KEY / STRIPE_SECRET (S4), REVERB_* (S5), clé du fournisseur IA (S6)
