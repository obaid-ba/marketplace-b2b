{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://marketplace-api-v2-8gr1.onrender.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://marketplace-web-v2.onrender.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://marketplace-api-v2-8gr1.onrender.com/api",
        "EXPO_PUBLIC_WEB_URL": "https://marketplace-web-v2.onrender.com"
      }
    }
  }
}
